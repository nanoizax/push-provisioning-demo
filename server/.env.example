# Mock issuer / TSP backend configuration
# Copy to `.env` and adjust. The server reads process.env directly (no dotenv dependency);
# on POSIX shells you can `export $(grep -v '^#' .env | xargs)` before `npm start`.

# TCP port the HTTP API listens on.
PORT=8787

# Bearer token the mobile apps must present (Authorization: Bearer <token>).
# In production this is a short-lived, per-session token minted after strong customer
# authentication (SCA) — never a static secret like this.
SESSION_TOKEN=demo-session-token

# Allowed CORS origin for the browser demo. The built-in default is "*" (demo only,
# so the offline demo works from any origin). In production, set a concrete origin:
CORS_ORIGIN=http://localhost:5510

# Set to 1 to include internal error details in HTTP 500 responses (development only).
# DEBUG_ERRORS=1
